# Copie ce fichier en `.env` à la racine, OU lance `npm run db:start`
# qui génère `.env` avec les clés locales + IP LAN.
#
# ⚠️  Ne JAMAIS committer `.env` (repo public).
# ⚠️  Ne JAMAIS mettre SUPABASE_SERVICE_ROLE_KEY dans EXPO_PUBLIC_*.
# ⚠️  Si une clé cloud a fuité (chat, commit, screenshot) → rotation immédiate.
# Checklist auth Firebase : FIREBASE_AUTH.md

# --- Firebase Auth (identité primaire : Google / Apple / email) ---
# Console Firebase → Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth Google — Web client ID (Firebase Authentication → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Username Expo (sans @) — obligatoire sous Expo Go pour le proxy HTTPS Google.
# npx expo whoami → EXPO_PUBLIC_EXPO_OWNER=ton-username
# Redirect Expo Go : https://auth.expo.io/@ton-username/jumelo
# Redirect web (forcé) : http://localhost:8081/oauth — npm run google:redirects
EXPO_PUBLIC_EXPO_OWNER=sofyan
# Optionnel (builds natifs)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Supabase (données : profiles, teams, messages) ---
# Option A : local (Colima) — `npm run db:start`
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_URL=http://127.0.0.1:54321

# Sur téléphone physique : remplace 127.0.0.1 par l’IP LAN du Mac.
# `npm run db:start` le fait automatiquement.

# --- Option B : Supabase cloud ---
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Pont Google/Apple → Supabase : activer les mêmes providers dans
# Supabase Auth (signInWithIdToken). Voir FIREBASE_AUTH.md.

# Sans EXPO_PUBLIC_FIREBASE_* ni SUPABASE_*, mode démo (__DEV__ uniquement).
